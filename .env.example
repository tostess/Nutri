# Fonte de dados: "local" (navegador, padrão) ou "supabase" (quando o banco estiver integrado)
NEXT_PUBLIC_DATA_SOURCE=local

# Supabase (preencher na integração com o banco)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp via Z-API (sem estas variáveis, o app abre o WhatsApp pelo link wa.me)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# Segredo exigido no webhook (?secret=) e no cron (Authorization: Bearer)
WHATSAPP_WEBHOOK_SECRET=
CRON_SECRET=

# Endereço público do app, usado nos links enviados às pacientes
NEXT_PUBLIC_APP_URL=http://localhost:3000
